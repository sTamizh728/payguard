# Copy to backend/.env and fill in. Never commit the real .env.

# PayPal sandbox app (developer.paypal.com -> Apps & Credentials)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Must match a Return URL under "Log in with PayPal" in the PayPal dashboard
PAYPAL_LOGIN_REDIRECT_URI=https://your-public-host/api/auth/paypal/callback

# Google Gemini (aistudio.google.com). Models are tried in order.
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3-flash-preview,gemini-flash-lite-latest

# PostgreSQL, e.g. postgresql+psycopg://user:password@localhost:5432/payguard
DATABASE_URL=

# Long random string used to sign login tokens
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# PayPal emails (Log in with PayPal) allowed to send money and refund
MERCHANT_ADMIN_EMAILS=

# PayPal webhook id (created via the API or dashboard) to verify webhook events
PAYPAL_WEBHOOK_ID=

# Twilio phone-call shop (optional). Point the number's Voice URL to
#   https://your-public-host/api/phone/voice  (HTTP POST)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
